# ==============================================================================
# DigitalClone Environment Configuration
# Copy this file to .env and fill in your credentials before running `serve`.
# Empty values fall back to safe defaults or offline --dry-run mode.
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Server & Persistence
# ------------------------------------------------------------------------------
PORT=8080
DRY_RUN=false

# PostgreSQL connection string (leave empty to use local SQLite)
DATABASE_URL=
SQLITE_PATH=./data/digitalclone.db

# Markdown persona prompts directory
PERSONAS_DIR=./personas

# ------------------------------------------------------------------------------
# Media Asset Hosting (Public HTTPS URL required by Buffer API)
# ------------------------------------------------------------------------------
ASSET_LOCAL_DIR=./assets
PUBLIC_BASE_URL=http://localhost:8080

# Optional S3-Compatible Storage (AWS S3 / Cloudflare R2 / MinIO)
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# ------------------------------------------------------------------------------
# Google ADK & GenAI (Required for live content, image, and video generation)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=imagen-3.0-generate-002
GEMINI_VIDEO_MODEL=veo-2.0-generate-001
# ------------------------------------------------------------------------------
# Buffer GraphQL API (LinkedIn, X, TikTok publishing)
# ------------------------------------------------------------------------------
BUFFER_API_KEY=
# Options: shareNow (default) or addToQueue
BUFFER_SHARE_MODE=shareNow

# Optional: auto-discovered via GetAccountHierarchy & GetChannels if empty
BUFFER_ORGANIZATION_ID=
BUFFER_LINKEDIN_CHANNEL_ID=
BUFFER_X_CHANNEL_ID=
BUFFER_TIKTOK_CHANNEL_ID=

# ------------------------------------------------------------------------------
# YouTube Data API v3 (Direct Video / Shorts upload)
# ------------------------------------------------------------------------------
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_ACCESS_TOKEN=
# Options: unlisted (default), private, or public
YOUTUBE_PRIVACY_STATUS=unlisted

# ------------------------------------------------------------------------------
# Discord Interactive Review Bot & Interactions Webhook
# ------------------------------------------------------------------------------
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_PUBLIC_KEY=

# ------------------------------------------------------------------------------
# Telegram Bot & Callback Webhook
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# GitHub Push Webhook & Diff Inspection
# ------------------------------------------------------------------------------
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
